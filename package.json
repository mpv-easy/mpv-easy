{
  "name": "mpv-easy",
  "private": "true",
  "version": "0.1.15-alpha.20",
  "workspaces": [
    "mpv-*"
  ],
  "homepage": "https://github.com/mpv-easy/mpv-easy#readme",
  "files": [
    "dist",
    "readme.md",
    "package.json"
  ],
  "description": "TS and React toolkit for mpv script",
  "scripts": {
    "pre-check": "npm run format && npm run lint:fix",
    "clippy": "cargo clippy --fix --allow-dirty --allow-staged",
    "dev": "bun run --parallel dev",
    "es5": "bun run --parallel es5",
    "build": "bun run --filter '*' build",
    "example": "bun run --parallel dev",
    "lint": "biome check --apply-unsafe",
    "format": "biome format --write",
    "lint:fix": "biome lint --write --unsafe",
    "test": "bun run --parallel test",
    "clean": "rm -R node_modules */node_modules",
    "clean-dist": "rimraf */dist */es5 */bundle",
    "release": "bun publish -r --access public",
    "release-alpha": "bun publish -r --access public --tag alpha",
    "bump": "bun up --latest"
  },
  "keywords": [
    "TS",
    "React",
    "mpv",
    "mpv script"
  ],
  "author": "ahaoboy <504595380@qq.com> (https://github.com/ahaoboy)",
  "license": "MIT",
