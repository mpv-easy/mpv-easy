{
  "name": "@mpv-easy/easy-react-tpl",
  "version": "0.1.15-alpha.20",
  "homepage": "https://github.com/mpv-easy/mpv-easy#readme",
  "files": [
    "dist",
    "readme.md",
    "package.json"
  ],
  "engines": {
    "node": "20"
  },
  "description": "mpv-easy-tpl",
  "main": "./dist/index.js",
  "scripts": {
    "bundle": "tsx scripts/build.ts",
    "es5": "babel --presets  @babel/preset-env ./bundle -d es5",
    "dev": "chokidar '../mpv-*/src/**/*' -c 'bun run build' -d 2000 --initial",
    "build": "bun run bundle && bun run es5",
    "build:osc": "bun run build && tsx scripts/build-osc.ts",
    "copy": "cp es5/mpv-easy-tpl.js $MPV_CONFIG_DIR",
    "download": "tsx scripts/download.ts"
  },
  "keywords": [],
  "author": "ahaoboy <504595380@qq.com> (https://github.com/ahaoboy)",
  "license": "MIT",
  "dependencies": {
    "@easy-install/easy-archive": "catalog:",
    "@mpv-easy/polyfill": "workspace:*",
    "@mpv-easy/react": "workspace:*",
    "@mpv-easy/tool": "workspace:*",
    "react": "catalog:"
  },
  "devDependencies": {
    "@babel/cli": "catalog:",
    "@babel/core": "catalog:",
    "@babel/preset-env": "catalog:",
    "@babel/preset-typescript": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "chokidar-cli": "catalog:",
    "esbuild": "catalog:",
    "tsx": "catalog:"
  }
}
